{
    "num_input_features": 21,
    "random_seed": 42,
    "data_split": {
        "train_val_size": 0.3,
        "random_state": 42
    },
    "flow": {
        "n_layers": 1,
        "hidden_features": 128,
        "num_bins": 32,
        "tails": "linear",
        "tail_bound": 5.0,
        "num_blocks": 2,
        "dropout_probability": 0.15,
        "activation": "silu",
        "min_bin_width": 0.01,
        "min_bin_height": 0.01,
        "min_derivative": 0.01
    },
    "training": {
        "learning_rate": 3e-4,
        "target_noise_std": 0.02,
        "epochs": 200,
        "train_batch_size": 512,
        "validation_batch_size": 1024,
        "test_batch_size": 512,
        "train_shuffle": true,
        "validation_shuffle": false,
        "test_shuffle": false,
        "weight_decay": 1e-4,
        "max_grad_norm": 5.0
    },
    "scheduler": {
        "type": "cosine",
        "eta_min": 1e-6
    }
}
